{
	"name": "Python URL Development",
	
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	"build": {
		"dockerfile": "Dockerfile"
	},

	"features": {
		"ghcr.io/devcontainers-extra/features/poetry:2": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},

	"forwardPorts": [
		7474,
		7687
	],

	"postCreateCommand": "python --version && poetry env use $(which python) && poetry config virtualenvs.in-project true && poetry lock && poetry install",
	
	"customizations": {
		"vscode": {
			"settings": {
				"python.analysis.typeCheckingMode": "strict"
			},
			"extensions": [
				"ms-python.python",
				"charliemarsh.ruff"
			]
		}
	}

}
